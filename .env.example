###############################################################################
# Telegram Fashion Marketplace — environment template
# Copy to .env and fill in. Nothing here is a secret by default: the stack
# boots with a mock payment provider and a deterministic AI engine, so the
# whole buyer -> order -> ledger -> refund flow works with zero third-party keys.
###############################################################################

NODE_ENV=development
LOG_LEVEL=debug

# ---------------------------------------------------------------- data stores
DATABASE_URL=postgresql://fashion:fashion@localhost:5432/fashion_marketplace?schema=public
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------- services
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
MINIAPP_PORT=3000
MINIAPP_PUBLIC_URL=http://localhost:3000
ADMIN_PORT=3001
ADMIN_PUBLIC_URL=http://localhost:3001

# CORS: comma separated list of allowed origins for browser clients
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# -------------------------------------------------------------------- session
# 32+ byte secrets. Rotate per environment (SEC-004).
SESSION_JWT_SECRET=dev-only-session-secret-change-me-0123456789abcdef
SESSION_ACCESS_TTL=900
SESSION_REFRESH_TTL=2592000
ADMIN_JWT_SECRET=dev-only-admin-secret-change-me-0123456789abcdef
ADMIN_SESSION_TTL=3600

# ------------------------------------------------------------------- telegram
# Bot token from @BotFather. Leave empty to run the Mini App in DEV_AUTH mode.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Public https URL of the Mini App, used for the bot's keyboard button.
TELEGRAM_MINIAPP_URL=
# Long polling (dev) or webhook (prod)
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
# initData max age in seconds (TG-001: stale payloads are rejected)
TELEGRAM_INITDATA_MAX_AGE=86400

# DEV ONLY. When 1, the Mini App may authenticate without valid Telegram
# initData so the product can be demoed in a plain browser. MUST be 0 in prod.
DEV_AUTH_ENABLED=1
DEV_AUTH_SECRET=dev-auth-secret-change-me

# ------------------------------------------------------------------- payments
# Payments are not live in this release. The orchestrator ships with a MOCK
# provider implementing the full internal contract (init -> callback -> refund)
# so commission, ledger and payouts are exercised end to end with no real money.
PAYMENTS_ENABLED=true
PAYMENTS_LIVE=false
PAYMENT_PROVIDERS=mock
MOCK_PAYMENT_WEBHOOK_SECRET=dev-mock-webhook-secret
# Real provider slots (PAY-002). Empty => adapter stays disabled, not stubbed-in.
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
UZUM_MERCHANT_ID=
UZUM_SECRET_KEY=

# ---------------------------------------------------------- commerce settings
DEFAULT_CURRENCY=UZS
DEFAULT_COMMISSION_BPS=1000
COMMISSION_INCLUDES_DELIVERY=false
RESERVATION_TTL_SECONDS=900
QUOTE_TTL_SECONDS=900
RETURN_WINDOW_DAYS=14
TIMEZONE=Asia/Tashkent

# ------------------------------------------------------------------------- ai
# The stylist works fully offline with a deterministic rule engine.
# Set AI_PROVIDER=anthropic and a key only to enable LLM-worded explanations.
AI_PROVIDER=local
AI_LLM_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=
AI_EXPLANATION_TIMEOUT_MS=6000
AI_FIT_CONFIDENCE_THRESHOLD=0.55

# -------------------------------------------------------------------- storage
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
STORAGE_PUBLIC_BASE=http://localhost:4000/media
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ----------------------------------------------------------------- rate limit
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=180
RATE_LIMIT_AI_MAX=20
RATE_LIMIT_AUTH_MAX=30
