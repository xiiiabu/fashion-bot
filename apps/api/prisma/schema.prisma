// Telegram Fashion Marketplace — data model
// Spec §14.1 (key entities), CAT-005 (money as integer minor units),
// PAY-008 (append-only ledger), ADM-006 (audit), SEL-001 (tenant isolation).
//
// Conventions:
//  - every money column is BigInt, in minor units, with a sibling currency
//  - every timestamp is stored UTC (§14.3); the UI renders Asia/Tashkent
//  - external ids are unique per seller so re-import upserts (CAT-001)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

